{
  "name": "sendpulse-gmail",
  "version": "2.0.0",
  "description": "Add people from your Gmail conversations to SendPulse mailing lists in one click",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-pageworld.js",
    "dev": "vite",
    "predev:firefox": "node scripts/copy-pageworld.js",
    "dev:firefox": "vite build --watch --mode firefox",
    "prebuild": "node scripts/copy-pageworld.js",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild:firefox": "node scripts/copy-pageworld.js",
    "build:firefox": "vue-tsc --noEmit && vite build --mode firefox",
    "zip": "npm run build && rm -f sendpulse-gmail.zip && cd dist && zip -qr ../sendpulse-gmail.zip .",
    "zip:firefox": "npm run build:firefox && rm -f sendpulse-gmail-firefox.zip && cd dist-firefox && zip -qr ../sendpulse-gmail-firefox.zip .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@inboxsdk/core": "^2.2.32",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
